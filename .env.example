# Application Environment Variables
PROJECT_NAME="SAIL Intelligent Freight Forecasting & Chartering System"
VERSION="1.0.0"
DEBUG=True
HOST="0.0.0.0"
PORT=8000

# Deployment Base URL — set this to your actual deployed URL on Vercel/Railway/etc.
# Used in admin notification emails so links work correctly in production.
APP_BASE_URL="https://your-project.vercel.app"

# Groq AI Configuration
GROQ_API_KEY="gsk_your_groq_api_key_here"
GROQ_MODEL="qwen/qwen3.8-27b"

# EIA (U.S. Energy Information Administration) — Oil & Fuel Prices
EIA_API_KEY="your_eia_api_key_here"

# Alpha Vantage — Commodity Prices (Coal, Iron Ore proxies)
ALPHA_VANTAGE_API_KEY="your_alpha_vantage_api_key_here"

# FRED (St. Louis Federal Reserve) — Macro Indicators (USD/INR, PMI)
FRED_API_KEY="your_fred_api_key_here"

# Supabase — Charter Inquiries Database
SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_key_here"
SUPABASE_SERVICE_KEY="sb_secret_your_key_here"

# Resend — Transactional Email
RESEND_API_KEY="re_your_resend_api_key_here"
OWNER_EMAIL="your@email.com"

# Admin Dashboard Secret Token
ADMIN_SECRET_TOKEN="your-secure-admin-token-here"
