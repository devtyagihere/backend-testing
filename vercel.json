{
  "version": 2,
  "functions": {
    "api/index.py": {
      "includeFiles": "{app/**,data/**}",
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/docs",
      "dest": "/api/index.py"
    },
    {
      "src": "/openapi.json",
      "dest": "/api/index.py"
    },
    {
      "src": "/sail-portal",
      "dest": "/api/index.py"
    },
    {
      "src": "/admin",
      "dest": "/api/index.py"
    },
    {
      "src": "/oris",
      "dest": "/api/index.py"
    },
    {
      "src": "/",
      "dest": "/api/index.py"
    }
  ]
}
